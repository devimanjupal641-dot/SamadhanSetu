PORT=5000
NODE_ENV=development
JWT_SECRET=samadhansetu_jwt_secret_key_demo
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database configuration (PostgreSQL + pgvector)
# If left commented or unavailable, backend automatically activates self-contained SQLite + Vector Math engine
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samadhansetu

# Redis Queue (BullMQ)
# If left empty, backend automatically uses internal resilient in-memory asynchronous worker queue
# REDIS_URL=redis://localhost:6379

# Pluggable SMS / WhatsApp Notification Sandbox Keys (optional; simulator active by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
